# Copy this file to .env and fill values before running
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.example.mongodb.net/mydb
EMAIL_USER=youremail@example.com
EMAIL_PASS=your_email_app_password_or_smtp_password
PORT=3000
# Optional: a permanent public URL provided by host (Render, Railway etc.)
PUBLIC_URL=
