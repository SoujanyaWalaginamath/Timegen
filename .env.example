 # Copy this file to .env and fill values before running
 # MongoDB Atlas connection string. Replace <user>, <pass>, <cluster>.
 # Example:
 # MONGO_URI=mongodb+srv://myUser:myPass@cluster0.mongodb.net/timetable_db?retryWrites=true&w=majority
MONGO_URI=

# Optional: Gmail SMTP (for sending real emails). Use an App Password, not your login password.
# EMAIL_USER=youremail@gmail.com
# EMAIL_PASS=your_app_password_here

# Optional: a permanent public URL provided by host (Render, Railway etc.)
PUBLIC_URL=
